# 复制为 .env 后填写。.env 不要提交到仓库。

# ===== 机器人 =====
BOT_NAME=大肥鱼
# 群聊里叫这些名字也会触发，用英文逗号分隔
BOT_ALIASES=大肥鱼,肥鱼
# 管理员 QQ 号：群聊里只有这个号能用 /reset，留空则群聊不能重置
ADMIN_QQ=

# ===== 大模型（DeepSeek）=====
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60

# ===== 联网搜索（DeepSeek Search API，复用上面的 Key，不用另外申请）=====
# true：遇到“最新/新闻/价格”这类消息时自动搜索网页（天气已交给天气工具）
WEB_SEARCH_ENABLED=true
# 每次最多取几条搜索结果（1-50）
WEB_SEARCH_COUNT=3
# 搜索超时秒数；失败只记日志，不影响正常聊天
WEB_SEARCH_TIMEOUT=15

# ===== 天气查询（Open-Meteo 免费接口，不需要 Key）=====
# true：问天气时先查结构化预报，不再依赖网页搜索的旧页面
WEATHER_ENABLED=true
# 天气接口超时秒数；失败只记日志，聊天照常
WEATHER_TIMEOUT=10

# ===== 链接解析 =====
# true：消息里带 B 站/网页链接时，抓标题、简介、热评、弹幕或正文给模型参考
LINK_PARSE_ENABLED=true
# 单个链接的抓取超时秒数；失败只记日志，照常聊天
LINK_PARSE_TIMEOUT=10
# 每条消息最多解析几个链接，避免一条消息卡太久
LINK_PARSE_MAX_LINKS=2

# ===== 语音 =====
# 语音识别（听别人的语音）：硅基流动免费模型 SenseVoiceSmall，需单独注册拿 Key
VOICE_ASR_ENABLED=true
SILICONFLOW_API_KEY=
VOICE_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
VOICE_ASR_TIMEOUT=30
# 语音回复（自己发语音）：微软 Edge TTS，免费、无需 Key
VOICE_TTS_ENABLED=true
VOICE_TTS_VOICE=zh-CN-XiaoyiNeural
VOICE_TTS_TIMEOUT=15
# 超过这么多字的回复不合成语音，改发文字
VOICE_TTS_MAX_CHARS=80

# ===== 红包气氛（只发祝福，不抢钱、不发钱）=====
RED_PACKET_ENABLED=true
# 收到红包后随机等几秒再说话
RED_PACKET_DELAY_MIN=1
RED_PACKET_DELAY_MAX=5
# 同一个会话两次红包反应的最小间隔（秒），防止刷屏
RED_PACKET_COOLDOWN=30

# ===== 主动消息（定时私聊号主，内容由模型按人设生成）=====
# 总开关；消息只发给上面的 ADMIN_QQ，留空 ADMIN_QQ 时不发送
PROACTIVE_ENABLED=true
# 发送间隔（分钟）：每次在最短和最长之间随机；号主在私聊里说话后重新计时
PROACTIVE_INTERVAL_MINUTES=20
PROACTIVE_INTERVAL_MAX_MINUTES=120
# 只在 [START_HOUR, END_HOUR) 这个时段内发送，整点计
PROACTIVE_START_HOUR=8
PROACTIVE_END_HOUR=23
# 计算时段用的 UTC 偏移小时数；中国为 8，服务器系统时区是 UTC 也不用改
PROACTIVE_UTC_OFFSET=8

# ===== NapCat 反向 WebSocket =====
# 本机服务监听地址；NapCat 与本程序在同一台电脑时保持 127.0.0.1
ONEBOT_HOST=127.0.0.1
ONEBOT_PORT=8080
ONEBOT_PATH=/onebot/v11/ws
# 必须和 NapCat WebUI 里配置的 token 一致；留空表示不校验（不安全，仅限本机测试）
ONEBOT_TOKEN=change-me
# 云服务器 Docker 部署时 NapCat WebUI 的登录 token，自己改一个随机字符串
NAPCAT_WEBUI_TOKEN=change-me-too

# ===== 回复与上下文 =====
MAX_REPLY_CHARS=60
MAX_REPLY_SEGMENTS=3
# 同一会话相邻两条消息的随机间隔（秒）；分段回复时每段之间也会等这么久
SEGMENT_DELAY_MIN=3
SEGMENT_DELAY_MAX=5
CONTEXT_MESSAGES=20
SUMMARY_TRIGGER=40

# ===== 限流与群聊策略 =====
RATE_MIN_INTERVAL=0
RATE_PER_MINUTE=60
# 群聊里没人 @ 也没叫名字时，随机接话的概率，1 表示每条都接话
GROUP_REPLY_PROBABILITY=1
GROUP_COOLDOWN=0
QUOTE_REPLY=true

# ===== 人格语料（RAG）=====
# 语料目录，可以放多个 .md 文件；也可以指向单个 md 文件
KNOWLEDGE_PATH=knowledge
# 旧配置名，含义同 KNOWLEDGE_PATH，新部署可不填
# KNOWLEDGE_FILE=knowledge/hyacine.md
KNOWLEDGE_TOP_K=2
# 向量检索走阿里云百炼；不填 DASHSCOPE_API_KEY 时自动回退原来的字面检索
DASHSCOPE_API_KEY=
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT=20
# 余弦相似度阈值，低于它的语料片段不注入提示词
EMBEDDING_MIN_SCORE=0.40
# FAISS 索引目录，默认在 DATA_DIR 下；删掉后重启会自动重建
# KNOWLEDGE_INDEX_DIR=data/knowledge_index

# ===== 其他 =====
DATA_DIR=data
LOG_LEVEL=INFO
